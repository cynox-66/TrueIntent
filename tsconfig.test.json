{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [
    "packages/*/tests/**/*.ts",
    "apps/*/tests/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "eslint.config.mjs",
    "scripts/**/*.mts"
  ]
}
