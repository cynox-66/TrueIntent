# ==============================================================================
# CaptureLock Environment Configuration (Phase 0 Bootstrap)
#
# IMPORTANT:
# - Use Razorpay TEST MODE keys only. NEVER supply live mode credentials.
# - Copy this file to .env for local development: cp .env.example .env
# - Never commit the .env file to version control.
# ==============================================================================

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL - matches docker-compose.yml default)
DATABASE_URL=postgresql://capturelock:capturelock@localhost:5432/capturelock_dev

# Razorpay (TEST MODE ONLY)
# Format: rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_test_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Verification Engine Defaults (Phase 0 Stubs)
FRESHNESS_WINDOW_SECONDS=30
ENABLE_SPIRIT_CHECK=false
