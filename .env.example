# ==============================================================================
# TrueIntent environment configuration
#
# Copy to .env for local development: cp .env.example .env
# Never commit .env.
#
# Razorpay TEST MODE ONLY. A live-mode key is refused in three independent
# places: the integrations schema, the RazorpayTestClient constructor, and the
# configuration loader below. The default payment adapter is the deterministic
# fake, so a fresh checkout cannot reach a real API without being configured to.
# ==============================================================================

# ---- server ------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ---- database ----------------------------------------------------------------
# The API uses Postgres whenever this is set. Apply the schema with
# `pnpm db:up && pnpm db:migrate`.
DATABASE_URL=postgresql://capturelock:capturelock@localhost:5432/capturelock_dev

# postgres (default when DATABASE_URL is set) or memory. Production refuses
# `memory`, because a restart would silently lose every record.
# PERSISTENCE=postgres

# ---- separated authority -------------------------------------------------------
# An agent holds a principal (the x-capturelock-user / -session headers) and
# nothing else. These two are held by other parties, and the separation is what
# stops an agent minting its own mandate or clearing its own PAUSE.
#
# Outside production these fall back to predictable development values.
# Production refuses to start without real ones.
#
#   issuer   -> may create authorizations (the trusted user-facing application)
#   operator -> may resolve a paused review, force reconciliation (a human console)
# ISSUER_API_KEY=
# OPERATOR_API_KEY=

# ---- payment provider --------------------------------------------------------
# `fake` (default) or `razorpay-test`. Selecting razorpay-test requires the
# credentials below and refuses anything that is not an rzp_test_ key.
PAYMENT_PROVIDER=fake

# RAZORPAY_KEY_ID=rzp_test_replace_me
# RAZORPAY_KEY_SECRET=replace_me
# RAZORPAY_WEBHOOK_SECRET=replace_me

# ---- evidence signing --------------------------------------------------------
# Base64 PKCS#8 Ed25519 private key. Generated on the fly outside production so
# the service starts immediately; production refuses to boot without one, because
# a key that changes on restart makes every earlier envelope unverifiable.
#
# Generate one with:
#   node -e "const {generateKeyPairSync}=require('crypto');\
#   console.log(generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
# EVIDENCE_SIGNING_KEY=

# ---- verification tuning -----------------------------------------------------
# Snapshot lifetime. The effective window is the smaller of this and the
# authorization's own maxSnapshotAgeSeconds.
SNAPSHOT_TTL_SECONDS=30

# Release attempts permitted inside the velocity window before PAUSE.
MAX_ATTEMPTS_IN_WINDOW=3
VELOCITY_WINDOW_SECONDS=60

# ---- recovery ------------------------------------------------------------------
# How long a release may sit mid-provider-call before reconciliation looks at it.
RECONCILE_AFTER_SECONDS=30

# How long a release may sit in a transient state before the liveness sweep
# aborts it, freeing its authorization.
ABANDON_TRANSIENT_AFTER_SECONDS=120

# How long an execution grant remains usable. Short by design: a grant is
# consumed milliseconds after minting, in the same call.
GRANT_TTL_SECONDS=60

# How long Razorpay's order-by-receipt lookup may lag a write. Measured at
# roughly 8s against real test mode; an empty lookup inside this window is
# treated as inconclusive rather than as proof the order does not exist.
PROVIDER_LOOKUP_CONSISTENCY_SECONDS=60

# Background sweeper interval. 0 disables both sweeps.
SWEEP_INTERVAL_SECONDS=30

# ---- bounded buyer agent -------------------------------------------------------
# Which model the buyer agent reasons with.
#
# `auto` (the default) uses Anthropic when ANTHROPIC_API_KEY is set below, and
# the deterministic planner otherwise. Set the key and the agent reasons with a
# real model — nothing else is required.
#
# `deterministic` pins the planner regardless, which is what the offline suites
# and the scenario engine want: reproducible, no network, and predictable enough
# that a scenario is evidence about TrueIntent rather than about a model.
#
# `anthropic` demands the live model, and still falls back rather than failing
# if no key is present — a model that cannot be reached must never be a reason
# to skip a check.
#
# Selecting a model never changes what the model may do. Whichever one runs
# reaches the same bounded tool vocabulary, cannot state a price, a total or a
# verdict, and has every action validated against the session authority
# server-side.
BUYER_MODEL=auto
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# The operator policy every commerce session binds its purchases to. A session
# refuses to be created if this policy is missing, rather than being created
# with no operator constraints at all.
# AGENT_POLICY_ID=household_default
# AGENT_POLICY_VERSION=1.0.0

# How long a purchase's budget hold may sit unresolved before the sweep reads
# the release it belongs to and adopts its answer. Until that runs, the budget
# stays withheld — the safe direction.
SETTLE_AFTER_SECONDS=120
